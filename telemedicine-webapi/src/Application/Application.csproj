<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>telemedicine_webapi.Application</RootNamespace>
        <AssemblyName>telemedicine_webapi.Application</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Hospital\**" />
        <Compile Remove="Patient\**" />
        <Compile Remove="Physician\**" />
        <EmbeddedResource Remove="Hospital\**" />
        <EmbeddedResource Remove="Patient\**" />
        <EmbeddedResource Remove="Physician\**" />
        <None Remove="Hospital\**" />
        <None Remove="Patient\**" />
        <None Remove="Physician\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="15.1.1" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="MediatR" Version="14.1.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Admin\Commands\" />
      <Folder Include="HealthAnalysisReports\Commands\" />
      <Folder Include="HealthAnalysisReports\Queries\" />
    </ItemGroup>

</Project>
