{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "SqlServerConnectionSetting": {
    "ConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=telemedicine;Integrated Security=True;Pooling=False"
  },

  "DefaultConnection": "",

  "DemoData": {
    "Enabled": false
  },
  "SeedAdmin": false,

  "Database": { "ApplyMigrationsOnStartup": false },
  "Consultations": {
    "JoinWindowMinutesBefore": 15,
    "JoinWindowMinutesAfter": 30,
    "AllowOutsideWindow": false
  },
  "ForwardedHeaders": { "Enabled": false, "ForwardLimit": 1, "KnownProxies": [] },
  "Swagger": { "Enabled": false },
  "RateLimiting": {
    "Authentication": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Scheduling": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Payment": { "PermitLimit": 10, "WindowSeconds": 60 }
  },


  "BlobStorageSettings": {
    "ConnectionString": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://localhost:5173"
    ]
  },
  "WebRtc": {
    "Ice": {
      "Servers": []
    }
  }
}
